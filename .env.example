# Web SSH — окружение
# Скопировать в .env и выставить свои значения. Секреты в .env не коммитить (.gitignore).

# Где лежат данные: БД SQLite, мастер-ключ, сокеты сессий.
WEB_SSH_DATA_DIR=./data

# HTTP. За nginx/traefik слушать 127.0.0.1 и включать trust proxy.
WEB_SSH_HOST=127.0.0.1
WEB_SSH_PORT=3000
WEB_SSH_TRUST_PROXY=false

# Cookie с Secure: включать, когда сервис отдаётся по HTTPS.
WEB_SSH_COOKIE_SECURE=false

# Первый запуск: регистрация открыта, пока в БД нет ни одного пользователя.
# После создания владельца поставить false, иначе любой, кто дотянется до порта,
# сможет создать себе учётку.
WEB_SSH_ALLOW_REGISTRATION=true

# Сколько байт вывода сессии хранить на диске (история терминала).
WEB_SSH_SCROLLBACK_BYTES=8388608

# Сколько байт держать в памяти воркера для мгновенной перерисовки.
WEB_SSH_RING_BYTES=524288

# Срок жизни cookie-сессии в днях.
WEB_SSH_AUTH_SESSION_DAYS=30

# Путь к мастер-ключу шифрования кредов. По умолчанию <data>/master.key, права 0600.
# Ключ обязан лежать вне бэкапа БД: иначе бэкап = SSH-доступ.
# WEB_SSH_MASTER_KEY_FILE=/etc/web-ssh/master.key
