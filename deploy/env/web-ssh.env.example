# /etc/web-ssh/web-ssh.env — окружение сервиса на хосте (ставится из deploy/env/web-ssh.env.example).
# Права: root:root 0600. Секретов здесь нет: мастер-ключ и пароли кредов лежат в WEB_SSH_DATA_DIR.

# Данные: БД SQLite, мастер-ключ, сокеты сессий. Права каталога — 0700, владелец webssh.
WEB_SSH_DATA_DIR=/var/lib/web-ssh

# Снаружи порт закрыт: слушаем loopback, наружу выставляет только nginx.
WEB_SSH_HOST=127.0.0.1
WEB_SSH_PORT=3030

# За nginx: без trust proxy все входы в audit_log выглядят как 127.0.0.1.
WEB_SSH_TRUST_PROXY=true
# Сервис отдаётся только по HTTPS: cookie без Secure поедет в открытом виде.
WEB_SSH_COOKIE_SECURE=true

# Первый запуск: true → на / доступна регистрация владельца (нужен, пока в БД нет никого).
# ПОСЛЕ создания владельца выставить false и перезапустить:
#   sed -i 's/^WEB_SSH_ALLOW_REGISTRATION=.*/WEB_SSH_ALLOW_REGISTRATION=false/' \
#     /etc/web-ssh/web-ssh.env && systemctl restart web-ssh
# Перезапуск не рвёт терминалы (KillMode=process), но и оставлять открытую регистрацию
# на публичном адресе нельзя: любой, кто дотянется до порта, создаст себе учётку.
WEB_SSH_ALLOW_REGISTRATION=true

# История терминала на диске (8 МиБ ≈ десятки тысяч строк) и кольцо в памяти воркера.
WEB_SSH_SCROLLBACK_BYTES=8388608
WEB_SSH_RING_BYTES=524288

# Срок жизни cookie-сессии.
WEB_SSH_AUTH_SESSION_DAYS=30

# Мастер-ключ кредов: по умолчанию <данные>/master.key (0600). В бэкап БД не класть —
# бэкап вместе с ключом равен SSH-доступу ко всем хостам.
# WEB_SSH_MASTER_KEY_FILE=/var/lib/web-ssh/master.key

NODE_ENV=production
