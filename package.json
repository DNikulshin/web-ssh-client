{
  "name": "web-ssh-client",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Веб-SSH: сессии, переживающие перезапуск веб-слоя и падение хоста; креды в БД под шифрованием",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.json && node tools/copy-assets.mjs",
    "start": "node dist/index.js",
    "hub": "node src/hub/hub.ts",
    "verify": "node tools/verify.mjs",
    "test": "node --test test/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/static": "^7.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fastify": "^4.28.1",
    "ssh2": "^1.15.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ssh2": "^1.15.1",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "cpu-features",
      "ssh2"
    ]
  }
}
